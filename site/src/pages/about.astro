---
import Layout from "../layouts/Layout.astro";
import Rule from "../components/Rule.astro";
import Sigil from "../components/Sigil.astro";
import { SERIES } from "../data/site";

const reachAbout = [
  ["Natal & mundane charts", "Personal readings, world charts, the long sub-cycles."],
  ["Remote viewing", "Methodology and lineage. Not on-demand readings."],
  ["The simulation argument", "As a working frame, not as a cosmology."],
  ["Orthodox Christian inquiry", "Quietly, and with care."],
];
---

<Layout title="About — J.T. Worldteacher">
  <main class="page-in">
    <section class="hair-b">
      <div class="container about__head">
        <div class="eyebrow">About — J.T. Worldteacher</div>
        <h1 class="about__h1 font-display">The long form, for the patient.</h1>
      </div>
    </section>

    <section class="hair-b">
      <div class="container about__body">
        {/* Portrait */}
        <div class="about__portrait-col">
          <div class="about__portrait" aria-hidden="true">
            <div class="about__portrait-stripes"></div>
            <div class="about__portrait-center">
              <div class="about__portrait-sigil"><Sigil size={48} /></div>
              <div class="about__portrait-cap eyebrow">Portrait</div>
              <div class="about__portrait-sub eyebrow-strong">
                Drop in a real photo here
              </div>
            </div>
          </div>
          <div class="about__portrait-caption eyebrow-strong">
            Photographed indoors, late afternoon.
          </div>
        </div>

        {/* Bio */}
        <div class="about__bio-col">
          <Rule wide />
          <p class="about__lead font-display">
            Look — there are people who arrive at this material from one door.
            I arrived from several at once, and I have spent the years since
            trying to keep the rooms in conversation.
          </p>

          <div class="about__prose">
            <p>
              <span class="about__bio-pill">BIO · ~300 W</span>
              {/* TODO: replace placeholder bio with the real ~300-word version */}
              This block is a placeholder for the real bio. Replace this prose
              with the long form — how you came to Vedic and mundane astrology,
              when the remote viewing work started under the Dames protocols,
              the arc through simulation theory, and the quiet Orthodox
              backbone that has held the whole thing together.
            </p>
            <p>
              Remember — readers come here for the voice as much as the
              material. Keep it declarative. Mention the years on the air, the
              cities you've taught in, the projects that didn't survive, and
              the two or three teachers you actually owe. A real bio earns
              trust before any of the ideas do.
            </p>
            <p>
              Close with the present: the studio, the rotation of shows, the
              consultation practice, and what you are willing to be reached
              about. No marketing. Just the address of the desk.
            </p>
          </div>

          <Rule wide class="about__bio-rule" />

          <div>
            <div class="eyebrow about__series-h">Recurring shows & series</div>
            <ul class="about__series">
              {SERIES.map((s) => (
                <li class="about__series-item">
                  <span class="about__series-diamond" />
                  <div>
                    <div class="about__series-name font-display">{s.name}</div>
                    <div class="about__series-cadence eyebrow-strong">
                      {s.cadence}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="hair-b">
      <div class="container about__reach">
        <div class="about__reach-intro">
          <div class="eyebrow">§ What I'll talk about</div>
          <h2 class="about__reach-h font-display">
            Reach me about these. Not the rest.
          </h2>
        </div>
        <div class="about__reach-grid">
          {reachAbout.map(([h, b]) => (
            <div class="about__card">
              <div class="about__card-h font-display">{h}</div>
              <div class="about__card-b">{b}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .about__head {
    padding-top: 64px;
    padding-bottom: 64px;
  }
  @media (min-width: 768px) {
    .about__head {
      padding-top: 96px;
    }
  }
  .about__h1 {
    margin-top: 20px;
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.02em;
    font-size: clamp(48px, 7vw, 88px);
  }

  .about__body {
    padding-top: 56px;
    padding-bottom: 56px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 768px) {
    .about__body {
      padding-top: 80px;
      padding-bottom: 80px;
      grid-template-columns: 5fr 7fr;
      gap: 56px;
    }
  }

  .about__portrait {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bg-elev);
    border: 1px solid var(--hair-strong);
  }
  .about__portrait-stripes {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 14px,
      rgba(232, 225, 212, 0.04) 14px,
      rgba(232, 225, 212, 0.04) 15px
    );
  }
  .about__portrait-center {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 0 24px;
  }
  .about__portrait-sigil {
    color: var(--accent);
    display: inline-flex;
  }
  .about__portrait-cap {
    margin-top: 16px;
  }
  .about__portrait-sub {
    margin-top: 4px;
    color: var(--ink-mute);
  }
  .about__portrait-caption {
    margin-top: 16px;
    color: var(--ink-mute);
  }

  .about__lead {
    margin-top: 32px;
    font-style: italic;
    font-size: 24px;
    line-height: 1.3;
    color: var(--ink);
  }
  .about__prose {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 60ch;
    font-size: 16px;
    line-height: 1.72;
    color: var(--ink-soft);
  }
  .about__bio-pill {
    display: inline-block;
    margin-right: 8px;
    padding: 2px 6px;
    border: 1px solid var(--hair-strong);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    vertical-align: middle;
  }
  .about__bio-rule {
    margin: 40px 0;
  }
  .about__series-h {
    margin-bottom: 20px;
  }
  .about__series {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 32px;
    row-gap: 16px;
  }
  @media (min-width: 640px) {
    .about__series {
      grid-template-columns: 1fr 1fr;
    }
  }
  .about__series-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .about__series-diamond {
    margin-top: 8px;
    width: 6px;
    height: 6px;
    background: var(--accent);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
  .about__series-name {
    font-size: 18px;
    line-height: 1.2;
  }
  .about__series-cadence {
    margin-top: 2px;
    color: var(--ink-mute);
  }

  .about__reach {
    padding-top: 56px;
    padding-bottom: 56px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 768px) {
    .about__reach {
      padding-top: 80px;
      padding-bottom: 80px;
      grid-template-columns: 4fr 8fr;
      gap: 56px;
    }
  }
  .about__reach-h {
    margin-top: 12px;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.05;
  }
  .about__reach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .about__reach-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .about__card {
    padding: 20px;
    border: 1px solid var(--hair);
    background: var(--bg-elev);
  }
  .about__card-h {
    font-size: 20px;
    line-height: 1.2;
  }
  .about__card-b {
    margin-top: 8px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
</style>
