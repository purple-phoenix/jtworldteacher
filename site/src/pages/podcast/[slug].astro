---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes', ({ data }) => !data.draft);
  return episodes.map((ep) => ({
    params: { slug: ep.id.replace(/\.md$/, '') },
    props: { ep },
  }));
}

const { ep } = Astro.props;
const { Content } = await render(ep);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${ep.data.title} — JT`} description={ep.data.description}>
  <main>
    <p style="margin-top: 2rem;">
      <a href={import.meta.env.BASE_URL + 'podcast/'}>← All episodes</a>
    </p>

    <article>
      <h1 style="font-size: 2rem; margin: 1.5rem 0 0.5rem;">{ep.data.title}</h1>
      <p style="color: var(--muted); margin: 0 0 1.5rem;">
        {dateFmt.format(ep.data.pubDate)} · {ep.data.duration}
        {ep.data.spaceUrl && (
          <> · <a href={ep.data.spaceUrl} rel="noopener">originally an X Space</a></>
        )}
      </p>

      <audio controls preload="none" style="width: 100%; margin: 1rem 0 2rem;">
        <source src={ep.data.audioUrl} type={ep.data.audioType} />
        Your browser does not support audio playback.
        <a href={ep.data.audioUrl}>Download the audio</a>.
      </audio>

      <aside class="summary-card">
        <h2 style="margin: 0 0 0.5rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); font-weight: normal;">Summary</h2>
        <p style="margin: 0; font-size: 1.05rem;">{ep.data.description}</p>
      </aside>

      <Content />
    </article>

    <p style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule);">
      <a href={import.meta.env.BASE_URL + 'podcast/'}>← All episodes</a>
    </p>
  </main>

  <footer>
    © {new Date().getFullYear()} JT. All rights reserved.
  </footer>
</Layout>

<style>
  .summary-card {
    background: rgba(75, 46, 131, 0.06);
    border-left: 3px solid var(--accent);
    padding: 1.25rem 1.5rem;
    margin: 0 0 2rem;
    border-radius: 2px;
  }
</style>
