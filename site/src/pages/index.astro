---
import Layout from "../layouts/Layout.astro";
---

<Layout title="JT — Astrology & Simulation Theory">
  <header class="hero">
    <h1>JT</h1>
    <p class="tagline">Astrology and simulation theory.</p>
  </header>

  <main>
    <section>
      <h2>About</h2>
      <p>
        A long-form inquiry into what the chart says about the nature of the
        reality we appear to be inside of. Slow, unhurried, and meant for
        people already asking the question.
      </p>
      <!-- TODO: replace with real bio once the framework recordings are done -->
    </section>

    <section>
      <h2>Podcast</h2>
      <p>
        New episodes most weeks. Available wherever you listen.
      </p>
      <ul class="links">
        <li><a href={import.meta.env.BASE_URL + 'podcast/'}>All episodes</a></li>
        <li><a href="#" rel="noopener">Spotify</a> <!-- TODO: submit feed --></li>
        <li><a href="#" rel="noopener">Apple Podcasts</a> <!-- TODO: submit feed --></li>
        <li><a href="#" rel="noopener">YouTube</a> <!-- TODO --></li>
        <li><a href={import.meta.env.BASE_URL + 'feed.xml'}>RSS feed</a></li>
      </ul>
    </section>

    <section>
      <h2>Consultations</h2>
      <p>
        One-on-one sessions for people who want to go deeper with their own
        chart. Honest pricing, no pressure.
      </p>
      <p>
        <a href="#" rel="noopener">Book a session →</a>
        <!-- TODO: replace with Acuity or Calendly link -->
      </p>
    </section>

    <section>
      <h2>Support the work</h2>
      <p>
        The podcast is free. If it's been useful and you'd like to support it
        directly, you can do so here.
      </p>
      <ul class="links">
        <li><a href="#" rel="noopener">One-time contribution</a> <!-- TODO: Stripe Payment Link --></li>
        <li><a href="#" rel="noopener">Monthly support (Patreon)</a> <!-- TODO: add later --></li>
      </ul>
    </section>

    <section>
      <h2>Contact</h2>
      <p>
        For interviews, collaborations, or correspondence:
        <a href="mailto:hello@example.com">hello@example.com</a>
        <!-- TODO: real email -->
      </p>
    </section>
  </main>

  <footer>
    © {new Date().getFullYear()} JT. All rights reserved.
  </footer>
</Layout>
