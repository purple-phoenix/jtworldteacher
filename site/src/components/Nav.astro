---
import Sigil from "./Sigil.astro";
import Icon from "./Icon.astro";

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") + "/";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const items = [
  { id: "home", label: "Home", href: base, match: (p: string) => p === base.replace(/\/$/, "") || p === "/" },
  { id: "about", label: "About", href: base + "about/", match: (p: string) => p.startsWith(base + "about") },
  { id: "writing", label: "Writing", href: base + "writing/", match: (p: string) => p.startsWith(base + "writing") },
  { id: "podcast", label: "Podcast", href: base + "podcast/", match: (p: string) => p.startsWith(base + "podcast") },
  { id: "consult", label: "Consultations", href: base + "consultations/", match: (p: string) => p.startsWith(base + "consultations") },
];
---

<header class="nav">
  <div class="nav__inner container">
    <a href={base} class="nav__brand">
      <span class="nav__brand-sigil"><Sigil size={22} /></span>
      <span class="font-display nav__brand-name">J.T. Worldteacher</span>
    </a>

    <nav class="nav__links">
      {items.map((it) => (
        <a
          href={it.href}
          class:list={["nav__link", "link-u", { "is-active": it.match(path) }]}
        >
          {it.label}
        </a>
      ))}
    </nav>

    <button class="nav__menu" type="button" aria-label="Menu" data-menu-open>
      <Icon name="menu" size={18} />
    </button>
  </div>

  <div class="nav__overlay" data-menu-overlay hidden>
    <div class="nav__overlay-bar container">
      <span class="nav__brand">
        <span class="nav__brand-sigil"><Sigil size={20} /></span>
        <span class="font-display nav__brand-name">J.T. Worldteacher</span>
      </span>
      <button class="nav__menu" type="button" aria-label="Close" data-menu-close>
        <Icon name="close" size={18} />
      </button>
    </div>
    <div class="nav__overlay-list container">
      {items.map((it) => (
        <a
          href={it.href}
          class:list={["nav__overlay-link", "font-display", { "is-active": it.match(path) }]}
        >
          {it.label}
        </a>
      ))}
      <div class="nav__overlay-tag eyebrow">Astrology and simulation theory</div>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    border-bottom: 1px solid var(--hair);
  }
  .nav__inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .nav__brand-sigil {
    color: var(--accent);
    display: inline-flex;
  }
  .nav__brand-name {
    font-size: 19px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .nav__links {
    display: none;
    align-items: center;
    gap: 32px;
  }
  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
  }
  .nav__link {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .nav__link.is-active {
    color: var(--accent);
  }
  .nav__menu {
    background: transparent;
    border: 0;
    color: var(--ink-soft);
    padding: 8px;
    cursor: pointer;
    display: inline-flex;
  }
  @media (min-width: 768px) {
    .nav__menu {
      display: none;
    }
  }
  .nav__overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--bg);
  }
  .nav__overlay-bar {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--hair);
  }
  .nav__overlay-list {
    padding-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .nav__overlay-link {
    font-size: 32px;
    line-height: 1.1;
    color: var(--ink);
  }
  .nav__overlay-link.is-active {
    color: var(--accent);
  }
  .nav__overlay-tag {
    padding-top: 32px;
  }
</style>

<script>
  const open = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const close = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const overlay = document.querySelector<HTMLDivElement>("[data-menu-overlay]");

  open?.addEventListener("click", () => {
    if (overlay) overlay.hidden = false;
    document.body.style.overflow = "hidden";
  });
  close?.addEventListener("click", () => {
    if (overlay) overlay.hidden = true;
    document.body.style.overflow = "";
  });
</script>
