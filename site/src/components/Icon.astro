---
type IconName =
  | "play"
  | "pause"
  | "arrow"
  | "rss"
  | "spotify"
  | "apple"
  | "youtube"
  | "x"
  | "mail"
  | "menu"
  | "close";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 14, class: cls = "" } = Astro.props;
const stroke = 1.5;
---

{
  name === "play" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={cls} aria-hidden="true">
      <path d="M8 5v14l11-7z" />
    </svg>
  )
}
{
  name === "pause" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={cls} aria-hidden="true">
      <rect x="6" y="5" width="4" height="14" />
      <rect x="14" y="5" width="4" height="14" />
    </svg>
  )
}
{
  name === "arrow" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width={stroke} class={cls} aria-hidden="true">
      <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "rss" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={cls} aria-hidden="true">
      <path d="M4 4v3a13 13 0 0 1 13 13h3A16 16 0 0 0 4 4zm0 6v3a7 7 0 0 1 7 7h3a10 10 0 0 0-10-10zm2 7a2 2 0 1 0 0 4 2 2 0 0 0 0-4z" />
    </svg>
  )
}
{
  name === "spotify" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={cls} aria-hidden="true">
      <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm4.6 14.4a.65.65 0 0 1-.9.22c-2.46-1.5-5.56-1.84-9.2-1a.65.65 0 1 1-.3-1.26c4-.92 7.4-.53 10.14 1.14a.65.65 0 0 1 .26.9zm1.24-2.78a.81.81 0 0 1-1.12.27c-2.82-1.74-7.12-2.24-10.46-1.23a.81.81 0 1 1-.47-1.55c3.82-1.16 8.56-.6 11.8 1.4a.81.81 0 0 1 .25 1.11zm.11-2.9C14.6 8.74 9.2 8.54 6.13 9.47a.97.97 0 1 1-.56-1.86c3.53-1.07 9.5-.86 13.24 1.37a.97.97 0 0 1-1 1.66z" />
    </svg>
  )
}
{
  name === "apple" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={cls} aria-hidden="true">
      <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm.85 3.2a.78.78 0 0 1 .8.78v9.2a3.2 3.2 0 1 1-1.55-2.74V8.3a.78.78 0 0 1 .75-.78z" />
    </svg>
  )
}
{
  name === "youtube" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={cls} aria-hidden="true">
      <path d="M21.6 7.2a2.5 2.5 0 0 0-1.75-1.77C18.3 5 12 5 12 5s-6.3 0-7.85.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.75 1.77C5.7 19 12 19 12 19s6.3 0 7.85-.43A2.5 2.5 0 0 0 21.6 16.8 26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3z" />
    </svg>
  )
}
{
  name === "x" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={cls} aria-hidden="true">
      <path d="M18.9 3H22l-7.6 8.7L23 21h-6.9l-5.4-7-6.2 7H1.4l8.1-9.3L1 3h7l4.9 6.5L18.9 3zm-1.2 16h1.9L7.2 5H5.2l12.5 14z" />
    </svg>
  )
}
{
  name === "mail" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width={stroke} class={cls} aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="M3 7l9 6 9-6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "menu" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width={stroke} class={cls} aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "close" && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width={stroke} class={cls} aria-hidden="true">
      <path d="M5 5l14 14M19 5L5 19" stroke-linecap="round" />
    </svg>
  )
}
