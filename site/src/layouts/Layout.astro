---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Astrology and simulation theory — a long-form inquiry.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="topnav">
      <a href={import.meta.env.BASE_URL}>JT</a>
      <a href={import.meta.env.BASE_URL + 'podcast/'}>Podcast</a>
      <a href={import.meta.env.BASE_URL + 'feed.xml'}>RSS</a>
    </nav>
    <slot />
    <style is:global>
      nav.topnav {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1.5rem 1.25rem 0;
        display: flex;
        gap: 1.5rem;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
      }
      nav.topnav a {
        color: var(--muted);
        border-bottom: none;
      }
      nav.topnav a:hover {
        color: var(--ink);
      }
      :root {
        --bg: #f6f3ec;
        --ink: #1a1a1a;
        --muted: #5a5a5a;
        --rule: #d8d2c4;
        --accent: #4b2e83;
        --max: 720px;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      main {
        max-width: var(--max);
        margin: 0 auto;
        padding: 4rem 1.25rem 6rem;
      }

      header.hero {
        padding: 6rem 1.25rem 3rem;
        max-width: var(--max);
        margin: 0 auto;
      }

      header.hero h1 {
        font-size: 2.4rem;
        line-height: 1.15;
        margin: 0 0 0.75rem;
        letter-spacing: -0.01em;
      }

      header.hero p.tagline {
        margin: 0;
        color: var(--muted);
        font-style: italic;
        font-size: 1.15rem;
      }

      section {
        padding: 2.5rem 0;
        border-top: 1px solid var(--rule);
      }

      section h2 {
        font-size: 1.05rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
        margin: 0 0 1.25rem;
        font-weight: normal;
      }

      section p {
        margin: 0 0 1rem;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
        transition: border-color 120ms ease;
      }

      a:hover {
        border-bottom-color: var(--accent);
      }

      ul.links {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      ul.links li {
        margin: 0.4rem 0;
      }

      footer {
        max-width: var(--max);
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
        color: var(--muted);
        font-size: 0.9rem;
        border-top: 1px solid var(--rule);
      }
    </style>
  </body>
</html>
